# Waynesboro OS data connectors
# Copy to .env.local on the VPS and fill in real values.
# Never commit .env.local or paste secret keys into chat.

# Data Commons
# Public API key / token if your Data Commons account provides one.
DATA_COMMONS_API_KEY=

# Optional: only if your Data Commons plan explicitly provides a separate secret.
# Keep this server-side only. Do not expose it to browser/client code.
DATA_COMMONS_API_SECRET=

---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const briefingUrl = `${base}briefing/`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${briefingUrl}`} />
    <link rel="canonical" href={briefingUrl} />
    <title>Waynesboro OS · Briefing moved</title>
  </head>
  <body>
    <p>Waynesboro OS Briefing has moved to <a href={briefingUrl}>/briefing/</a>.</p>
  </body>
</html>

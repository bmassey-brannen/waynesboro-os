---
import WaynesboroTerminal from '../components/WaynesboroTerminal.jsx';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Waynesboro OS downtown source checks, map evidence caveats, and project source gates." />
    <title>Waynesboro OS · Downtown + Projects</title>
  </head>
  <body>
    <WaynesboroTerminal client:load page="downtown" />
  </body>
</html>

---
import WaynesboroTerminal from '../components/WaynesboroTerminal.jsx';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Waynesboro OS is a municipal intelligence terminal for understanding, managing, and improving Waynesboro, Georgia."
    />
    <title>Waynesboro OS · Municipal Intelligence Terminal</title>
  </head>
  <body>
    <WaynesboroTerminal client:load page="executive" />
  </body>
</html>
